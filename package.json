{
    "name": "bolt",
    "version": "6.1.7",
    "homepage": "https://boltcms.io",
    "author": "Bob den Otter <bob@twokings.nl> (https://boltcms.io)",
    "license": "MIT",
    "description": "Bolt 5 npm/javascript packages",
    "keywords": [
        "bolt",
        "cms",
        "php",
        "symfony",
        "vue",
        "content",
        "management",
        "system"
    ],
    "bugs": {
        "url": "https://github.com/bolt/core/issues"
    },
    "main": "webpack.config.js",
    "directories": {
        "tests": "tests"
    },
    "repository": {
        "type": "git",
        "url": "git://github.com/bolt/core.git"
    },
    "overrides": {
        "@achrinza/node-ipc": "^9.2.6",
        "@symfony/webpack-encore": {
            "eslint": "$eslint",
            "typescript": "$typescript"
        }
    },
    "dependencies": {
        "@popperjs/core": "^2.11.8",
        "axios": "^1.18.0",
        "baguettebox.js": "^1.11.1",
        "bootstrap": "5.3.*",
        "browserslist": "^4.22.1",
        "clipboard": "^2.0.11",
        "codemirror": "^5.65.15",
        "dropzone": "^5.9.3",
        "flagpack-dart-sass": "^1.4.0",
        "hotkeys-js": "^3.12.0",
        "jquery": "^3.7.1",
        "locutus": "^3.0.25",
        "luxon": "^1.28.1",
        "no-scroll": "^2.1.1",
        "node-vibrant": "^4.0.4",
        "popper.js": "^1.16.1",
        "register-service-worker": "^1.7.2",
        "selectize": "^0.12.6",
        "terser": "^4.8.1",
        "tinycolor2": "^1.6.0",
        "vue": "^2.7.15",
        "vue-easymde": "^2.0.0",
        "vue-flatpickr-component": "^8.1.8",
        "vue-multiselect": "^2.1.8",
        "vue-trumbowyg": "^3.6.2",
        "vuedraggable": "^2.24.3",
        "vuex": "^3.6.2",
        "zxcvbn": "^4.4.2"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@babel/polyfill": "^7.12.1",
        "@babel/preset-env": "^7.29.7",
        "@eslint/js": "^10.0.1",
        "@fortawesome/fontawesome-free": "^5.15.4",
        "@symfony/webpack-encore": "^4.7.0",
        "@testing-library/cypress": "^10.1.3",
        "@types/luxon": "^1.27.1",
        "ajv-keywords": "^5.1.0",
        "autoprefixer": "^10.5.4",
        "clean-webpack-plugin": "^4.0.0",
        "core-js": "^3.50.0",
        "cypress": "^15.20.1",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-cypress": "^7.0.0",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-vue": "^10.10.0",
        "file-loader": "^6.2.0",
        "genversion": "^3.2.0",
        "globals": "^17.11.0",
        "html-webpack-plugin": "^5.6.8",
        "pa11y-ci": "^4.1",
        "postcss": "^8.5.26",
        "postcss-loader": "^8.2.1",
        "postcss-preset-env": "^7.8.3",
        "postcss-scss": "^4.0.9",
        "prettier": "^3.9.6",
        "regenerator-runtime": "^0.14.1",
        "sass": "^1.102.0",
        "sass-loader": "^14.2.1",
        "source-sans-pro": "^3.6.0",
        "stylelint": "^17.14.1",
        "stylelint-config-recommended-scss": "^17.0.1",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-scss": "^7.2.0",
        "ts-loader": "^9.6.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.67.0",
        "vue-eslint-parser": "^10.4.1",
        "vue-loader": "^15.11.1",
        "webpack": "^5.72.0",
        "webpack-cli": "^5.1.4",
        "webpack-notifier": "^1.15.0",
        "webpackbar": "^7.0.0",
        "workbox-webpack-plugin": "^7.4.1"
    },
    "scripts": {
        "start": "encore dev-server --port=8234 --progress",
        "build": "npm run genversion && encore production --progress",
        "postbuild": "rm public/assets/fonts/*.ttf; rm public/assets/fonts/*.eot; rm public/assets/fonts/*.woff; rm public/assets/images/fa-*.svg",
        "build:stats": "encore production --progress --json > webpack_stats.json",
        "serve": "encore dev --watch",
        "lint": "eslint assets",
        "lint-fix": "eslint assets --fix",
        "typecheck": "tsc --noEmit",
        "stylelint": "stylelint 'assets/scss'",
        "stylelint-fix": "stylelint 'assets/scss' --fix",
        "csfix": "eslint assets --fix; stylelint 'assets/scss' --fix",
        "a11y:test:all": "pa11y-ci --config=tests/a11y/pa11yci.json",
        "a11y:test": "pa11y-ci",
        "genversion": "genversion --es6 --semi assets/js/version.js",
        "cypress:ci": "cypress run --config-file=tests/cypress/cypress.config.ci.js --quiet",
        "cypress:dev": "cypress run --config-file=tests/cypress/cypress.config.dev.js",
        "cypress:open": "cypress open --config-file=tests/cypress/cypress.config.dev.js"
    },
    "browserslist": [
        "> 1%"
    ]
}
