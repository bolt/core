{
    "name": "bolt",
    "version": "6.1.10",
    "homepage": "https://boltcms.io",
    "author": "Bob den Otter <bob@twokings.nl> (https://boltcms.io)",
    "license": "MIT",
    "description": "Bolt 6 npm/javascript packages",
    "keywords": [
        "bolt",
        "cms",
        "php",
        "symfony",
        "vue",
        "content",
        "management",
        "system"
    ],
    "bugs": {
        "url": "https://github.com/bolt/core/issues"
    },
    "main": "webpack.config.mjs",
    "directories": {
        "tests": "tests"
    },
    "repository": {
        "type": "git",
        "url": "git://github.com/bolt/core.git"
    },
    "overrides": {
        "@achrinza/node-ipc": "^9.2.6",
        "@symfony/webpack-encore": {
            "eslint": "$eslint",
            "typescript": "$typescript"
        }
    },
    "engines": {
        "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
    },
    "dependencies": {
        "@popperjs/core": "^2.11.8",
        "axios": "^1.20.0",
        "baguettebox.js": "^1.13.0",
        "bootstrap": "5.3.*",
        "browserslist": "^4.28.8",
        "clipboard": "^2.0.11",
        "codemirror": "^5.65.21",
        "dropzone": "^6.0.0-beta.2",
        "easymde": "^2.21.0",
        "flagpack-dart-sass": "^2.0.0",
        "hotkeys-js": "^4.0.4",
        "jquery": "^3.7.1",
        "locutus": "^3.0.36",
        "luxon": "^3.7.2",
        "mitt": "^3.0.1",
        "no-scroll": "^2.1.1",
        "node-vibrant": "^4.0.4",
        "pinia": "^3.0.4",
        "popper.js": "^1.16.1",
        "register-service-worker": "^1.7.2",
        "selectize": "^0.12.6",
        "terser": "^5.50.0",
        "tinycolor2": "^1.6.0",
        "vue": "^3.5.39",
        "vue-flatpickr-component": "^12.0.0",
        "vue-multiselect": "^3.5.0",
        "vue-trumbowyg": "^4.0.0",
        "vuedraggable": "^4.1.0",
        "zxcvbn": "^4.4.2"
    },
    "devDependencies": {
        "@babel/core": "^8.0.1",
        "@babel/polyfill": "^7.12.1",
        "@babel/preset-env": "^8.0.2",
        "@eslint/js": "^10.0.1",
        "@fortawesome/fontawesome-free": "^5.15.4",
        "@symfony/webpack-encore": "^7.1.0",
        "@testing-library/cypress": "^10.1.3",
        "@types/bootstrap": "^5.2.11",
        "@types/jquery": "^3.5.34",
        "@types/luxon": "^3.7.2",
        "@types/no-scroll": "^2.1.2",
        "@types/tinycolor2": "^1.4.6",
        "@types/zxcvbn": "^4.4.5",
        "@vitejs/plugin-vue": "^6.0.7",
        "@vitest/coverage-v8": "^4.1.11",
        "@vitest/ui": "^4.1.11",
        "@vue/test-utils": "^2.4.11",
        "ajv-keywords": "^5.1.0",
        "autoprefixer": "^10.5.4",
        "clean-webpack-plugin": "^4.0.0",
        "core-js": "^3.50.0",
        "cypress": "^15.20.1",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-cypress": "^7.0.0",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-sonarjs": "^4.1.0",
        "eslint-plugin-vue": "^10.10.0",
        "eslint-plugin-vuejs-accessibility": "^2.5.0",
        "file-loader": "^6.2.0",
        "genversion": "^3.2.0",
        "globals": "^17.11.0",
        "html-webpack-plugin": "^5.6.8",
        "jsdom": "^29.1.1",
        "pa11y-ci": "^4.1",
        "postcss": "^8.5.26",
        "postcss-loader": "^8.2.1",
        "postcss-preset-env": "^11.3.2",
        "postcss-scss": "^4.0.9",
        "prettier": "^3.9.6",
        "regenerator-runtime": "^0.14.1",
        "sass": "^1.102.0",
        "sass-loader": "^17.0.0",
        "source-sans-pro": "^3.6.0",
        "stylelint": "^17.14.1",
        "stylelint-config-recommended-scss": "^17.0.1",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-scss": "^7.2.0",
        "ts-loader": "^9.6.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.67.0",
        "vitest": "^4.1.11",
        "vue-eslint-parser": "^10.4.1",
        "vue-loader": "^17.4.2",
        "vue-tsc": "^3.3.7",
        "webpack": "^5.108.4",
        "webpack-cli": "^7.2.1",
        "webpack-dev-server": "^5.2.6",
        "webpack-notifier": "^1.15.0",
        "webpackbar": "^7.0.0",
        "workbox-webpack-plugin": "^7.4.1"
    },
    "scripts": {
        "start": "encore dev-server --port=8234 --progress",
        "build": "npm run genversion && encore production --progress",
        "postbuild": "rm -f public/assets/fonts/*.ttf; rm -f public/assets/fonts/*.eot; rm -f public/assets/fonts/*.woff; rm -f public/assets/images/fa-*.svg",
        "build:stats": "encore production --progress --json > webpack_stats.json",
        "serve": "encore dev --watch",
        "lint": "eslint assets tests/unit vitest.config.ts",
        "lint-fix": "eslint assets tests/unit vitest.config.ts --fix",
        "typecheck": "vue-tsc --noEmit",
        "stylelint": "stylelint 'assets/scss'",
        "stylelint-fix": "stylelint 'assets/scss' --fix",
        "csfix": "eslint assets tests/unit vitest.config.ts --fix; stylelint 'assets/scss' --fix",
        "test:unit": "vitest run",
        "test:unit:watch": "vitest",
        "test:unit:coverage": "vitest run --coverage",
        "test:unit:ui": "vitest --ui",
        "a11y:test:all": "pa11y-ci --config=tests/a11y/pa11yci.json",
        "a11y:test": "pa11y-ci",
        "genversion": "genversion --es6 --semi assets/js/version.js",
        "cypress:ci": "cypress run --config-file=tests/cypress/cypress.config.ci.js --quiet",
        "cypress:dev": "cypress run --config-file=tests/cypress/cypress.config.dev.js",
        "cypress:open": "cypress open --config-file=tests/cypress/cypress.config.dev.js"
    },
    "browserslist": [
        "> 1%"
    ]
}
